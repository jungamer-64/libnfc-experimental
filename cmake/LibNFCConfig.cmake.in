@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT "@BUILD_SHARED_LIBS@" STREQUAL "ON" AND
   ("@LIBNFC_DRIVER_PCSC@" STREQUAL "ON" OR "@LIBNFC_DRIVER_ACR122_PCSC@" STREQUAL "ON"))
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(PCSC)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LibNFCTargets.cmake")

set(_libnfc_static_link_libraries "@LIBNFC_STATIC_PACKAGE_LIBRARIES@")
set(_libnfc_static_frameworks "@LIBNFC_STATIC_PACKAGE_FRAMEWORKS@")
if(NOT "@BUILD_SHARED_LIBS@" STREQUAL "ON")
  list(PREPEND _libnfc_static_link_libraries "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@RUST_LIB_FILENAME@")
  list(APPEND _libnfc_static_link_libraries "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@LIBNFC_STATIC_TARGET_FILENAME@")
  foreach(_libnfc_framework ${_libnfc_static_frameworks})
    unset(_libnfc_framework_path CACHE)
    find_library(_libnfc_framework_path NAMES "${_libnfc_framework}")
    if(NOT _libnfc_framework_path)
      message(FATAL_ERROR "LibNFC static package requires the ${_libnfc_framework} framework")
    endif()
    list(APPEND _libnfc_static_link_libraries "${_libnfc_framework_path}")
  endforeach()
  unset(_libnfc_framework_path CACHE)
endif()

if(_libnfc_static_link_libraries)
  set_property(TARGET LibNFC::nfc APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${_libnfc_static_link_libraries}")
endif()

check_required_components(LibNFC)
